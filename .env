
# ════════════════════════════════════════════
# KAFKA — KRaft (sem ZooKeeper)
# ════════════════════════════════════════════
# Gere com: docker run --rm apache/kafka:4.0.0 kafka-storage random-uuid
# Gere UMA VEZ e nunca mude. É o identificador permanente do cluster.
KAFKA_CLUSTER_ID=ARFxX0baTni5nFcZ2GjjNA


# ════════════════════════════════════════════
# POSTGRESQL — User Service
# ════════════════════════════════════════════
# Usado por: container "postgres" + "user-service"
# SPRING_DATASOURCE_URL usa esses valores para montar a conexão JDBC
POSTGRES_USER=cloud
POSTGRES_PASSWORD=cloud20

# ════════════════════════════════════════════
# REDIS WEATHER — Weather Service
# ════════════════════════════════════════════
# Usado por: container "redis-weather" + "weather-service"
# Política: allkeys-lru (cache de radar meteorológico)
REDIS_WEATHER_PASSWORD=cloudWS

# ════════════════════════════════════════════
# REDIS ALERT — Alert Service
# ════════════════════════════════════════════
# Usado por: container "redis-alert" + "alert-service"
# Política: volatile-ttl (anti-duplicata TTL 30min)
REDIS_ALERT_PASSWORD=cloudAlert

# ════════════════════════════════════════════
# COCKROACHDB — Routing Service
# ════════════════════════════════════════════
# Usado por: container "cockroachdb" + "routing-service"
# Modo dev: --insecure (sem senha). Usuário padrão é sempre "root".
# A URL completa é montada no docker-compose-infra.yml:
# postgresql://${COCKROACH_USER}@cockroachdb:26257/${COCKROACH_DB}?sslmode=disable
COCKROACH_USER=root
COCKROACH_DB=routing

# ════════════════════════════════════════════
# LOCALSTACK — Observability Service
# AWS Gateway local: DynamoDB + API Gateway simulados
# ════════════════════════════════════════════
# Usado por: container "localstack" + "localstack-init" + "observability-service"
#
# ATENÇÃO: AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY são DUMMY.
# O LocalStack não valida credenciais localmente — aceita qualquer valor.
# A AWS SDK Java exige que essas variáveis estejam preenchidas para inicializar,
# caso contrário lança CredentialsException na aplicação.
#
# Em produção real na AWS: use IAM Roles, NUNCA credenciais hardcoded aqui.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# Endpoint aponta para o container LocalStack (gateway único porta 4566).
# Todos os serviços AWS simulados passam por essa URL.
# Dentro dos containers Docker, o host é "localstack" (nome do serviço).
DYNAMODB_ENDPOINT=http://localstack:4566

# ════════════════════════════════════════════
# SPRING BOOT — Configurações gerais
# ════════════════════════════════════════════
# Perfil ativo em todos os microserviços.
# "dev" ativa configurações locais (logs verbosos, sem SSL, etc.)
# Troque para "prod" no deploy de produção.
SPRING_PROFILES_ACTIVE=dev